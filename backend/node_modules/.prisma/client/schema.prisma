generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique @map("username")
  password                String
  fullName                String?
  kgidNumber              String?
  designationId           String?
  supervisorDesignationId String?
  supervisorUserId        String?
  districtId              String?
  isActive                Boolean  @default(true)
  isHeadOffice            Boolean  @default(false)
  role                    String   @default("user")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  designation           Designation? @relation("UserDesignation", fields: [designationId], references: [id])
  supervisorDesignation Designation? @relation("UserSupervisorDesignation", fields: [supervisorDesignationId], references: [id])
  supervisorUser        User?        @relation("UserSupervisor", fields: [supervisorUserId], references: [id])
  supervisees           User[]       @relation("UserSupervisor")
  district              District?    @relation(fields: [districtId], references: [id])

  officersCreated Officer[] @relation("OfficerCreatedBy")
  officersUpdated Officer[] @relation("OfficerUpdatedBy")

  petitionsCreated Petition[] @relation("PetitionCreatedBy")
  petitionsUpdated Petition[] @relation("PetitionUpdatedBy")

  historyActions PetitionHistory[] @relation("HistoryActionBy")
}

model Designation {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[] @relation("UserDesignation")
  usersAsSupervisor User[] @relation("UserSupervisorDesignation")
}

model District {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  officers  Officer[]
  users     User[]
}

model MasterItem {
  id        String   @id @default(uuid())
  category  String
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
  @@index([category])
}

model Officer {
  id               String                 @id @default(uuid())
  districtId       String
  name             String
  designation      String
  mobile           String
  reportingDate    DateTime
  presentAddress   String
  permanentAddress String
  remarks          String?
  isActive         Boolean                @default(true)
  createdById      String?
  updatedById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        User?                  @relation("OfficerCreatedBy", fields: [createdById], references: [id])
  district         District               @relation(fields: [districtId], references: [id])
  updatedBy        User?                  @relation("OfficerUpdatedBy", fields: [updatedById], references: [id])
  previousPlaces   OfficerPreviousPlace[]

  @@index([districtId])
  @@index([designation])
  @@index([mobile])
  @@index([reportingDate])
  @@index([isActive])
}

model OfficerPreviousPlace {
  id        String   @id @default(uuid())
  officerId String
  place     String
  fromYear  String?
  toYear    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  officer   Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@index([officerId])
}

model Petition {
  id                String            @id @default(uuid())
  district          String
  petitionNo        String            @unique
  petitionerName    String
  petitionerAddress String?
  sirOfficerName    String?
  officerRank       String?
  proposalStatus    String?
  proposalSentDate  DateTime?
  peNo              String?
  peRegDate         DateTime?
  peReportSentDate  DateTime?
  peStatus          String?
  sirEo             String?
  status            String            @default("DRAFT")
  createdById       String?
  updatedById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User?             @relation("PetitionCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?             @relation("PetitionUpdatedBy", fields: [updatedById], references: [id])
  remarks           Remark[]
  respondents       Respondent[]
  history           PetitionHistory[]
}

model Remark {
  id         String   @id @default(uuid())
  date       DateTime
  text       String
  petitionId String
  createdAt  DateTime @default(now())
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
}

model Respondent {
  id                       String    @id @default(uuid())
  name                     String
  designation              String?
  office                   String?
  department               String?
  subDepartment            String?
  caDesignation            String?
  caDepartment             String?
  caSubDepartment          String?
  caPlace                  String?
  permissionSentDate       DateTime?
  permissionReceivedFromCA DateTime?
  caSentToUnit             DateTime?
  permissionStatus         String?
  petitionId               String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  petition                 Petition  @relation(fields: [petitionId], references: [id], onDelete: Cascade)
}

model PetitionHistory {
  id                  String   @id @default(uuid())
  petitionId          String
  fromStatus          String?
  toStatus            String
  action              String
  actionById          String?
  actionByDesignation String?
  remarks             String?
  createdAt           DateTime @default(now())

  petition Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  actionBy User?    @relation("HistoryActionBy", fields: [actionById], references: [id], onDelete: SetNull)
}
