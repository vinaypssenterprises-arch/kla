generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique @map("username")
  password                String
  fullName                String?
  kgidNumber              String?
  designationId           String?
  supervisorDesignationId String?
  supervisorUserId        String?
  districtId              String?
  isActive                Boolean  @default(true)
  isHeadOffice            Boolean  @default(false)
  role                    String   @default("user")
  // Workspaces this user can open (petitions | officers | courtCases); admins always get all.
  // Keep the default in sync with DEFAULT_USER_MODULES in modulePermissions.js
  modules                 String[] @default(["petitions", "officers"])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  designation           Designation? @relation("UserDesignation", fields: [designationId], references: [id])
  supervisorDesignation Designation? @relation("UserSupervisorDesignation", fields: [supervisorDesignationId], references: [id])
  supervisorUser        User?        @relation("UserSupervisor", fields: [supervisorUserId], references: [id])
  supervisees           User[]       @relation("UserSupervisor")
  district              District?    @relation(fields: [districtId], references: [id])

  officersCreated Officer[] @relation("OfficerCreatedBy")
  officersUpdated Officer[] @relation("OfficerUpdatedBy")

  petitionsCreated Petition[] @relation("PetitionCreatedBy")
  petitionsUpdated Petition[] @relation("PetitionUpdatedBy")

  historyActions PetitionHistory[] @relation("HistoryActionBy")

  editRequestsRequested EditRequest[] @relation("EditRequest_requestedByIdToUser")
  editRequestsReviewed  EditRequest[] @relation("EditRequest_reviewedByIdToUser")

  courtCasesCreated CourtCase[] @relation("CourtCaseCreatedBy")
  courtCasesUpdated CourtCase[] @relation("CourtCaseUpdatedBy")

  @@index([districtId])
  @@index([designationId])
  @@index([isActive])
}

model Designation {
  id         String    @id @default(uuid())
  name       String
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users             User[] @relation("UserDesignation")
  usersAsSupervisor User[] @relation("UserSupervisorDesignation")

  @@unique([districtId, name])
  @@index([districtId])
}

model District {
  id           String        @id @default(uuid())
  name         String        @unique
  shortName    String?       @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  officers     Officer[]
  users        User[]
  designations Designation[]
  courtCases   CourtCase[]
}

model MasterItem {
  id        String   @id @default(uuid())
  category  String
  name      String
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([category, parentId])
}

model Officer {
  id                     String                 @id @default(uuid())
  districtId             String
  name                   String
  designation            String
  workingStatus          String                 @default("Working")
  mobile                 String?
  kgidNumber             String?
  dateOfJoiningDept      DateTime?
  trainingPlace          String?
  trainingFromDate       DateTime?
  trainingToDate         DateTime?
  nativePlace            String?
  educationQualification String?
  reportingDate          DateTime?
  personalMobile         String?
  presentAddress         String?
  permanentAddress       String?
  remarks                String?
  isActive               Boolean                @default(true)
  createdById            String?
  updatedById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  createdBy              User?                  @relation("OfficerCreatedBy", fields: [createdById], references: [id])
  district               District               @relation(fields: [districtId], references: [id])
  updatedBy              User?                  @relation("OfficerUpdatedBy", fields: [updatedById], references: [id])
  previousPlaces         OfficerPreviousPlace[]

  @@index([districtId])
  @@index([designation])
  @@index([workingStatus])
  @@index([mobile])
  @@index([kgidNumber])
  @@index([personalMobile])
  @@index([reportingDate])
  @@index([isActive])
}

model OfficerPreviousPlace {
  id            String    @id @default(uuid())
  officerId     String
  designation   String?
  policeStation String?
  district      String?
  fromDate      DateTime?
  toDate        DateTime?
  place         String?
  fromYear      String?
  toYear        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  officer       Officer   @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@index([officerId])
}

model Petition {
  id                String            @id @default(uuid())
  district          String
  petitionNo        String            @unique
  petitionerName    String
  petitionerAddress String?
  type              String?           @default("Complaint")
  sirOfficerName    String?
  officerRank       String?
  proposalStatus    String?
  proposalSentDate  DateTime?
  peNo              String?
  peRegDate         DateTime?
  peReportSentDate  DateTime?
  peStatus          String?
  sirEo             String?
  sirEoDesignation  String?
  status            String            @default("DRAFT")
  createdById       String?
  updatedById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User?             @relation("PetitionCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?             @relation("PetitionUpdatedBy", fields: [updatedById], references: [id])
  remarks           Remark[]
  respondents       Respondent[]
  history           PetitionHistory[]

  @@index([district])
  @@index([status])
  @@index([peStatus])
  @@index([proposalStatus])
  @@index([type])
  @@index([createdAt])
  @@index([peRegDate])
  @@index([proposalSentDate])
  @@index([createdById])
}

model Remark {
  id         String   @id @default(uuid())
  date       DateTime
  text       String
  petitionId String
  createdAt  DateTime @default(now())
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  @@index([petitionId])
}

model Respondent {
  id                       String    @id @default(uuid())
  name                     String
  designation              String?
  office                   String?
  department               String?
  subDepartment            String?
  caDesignation            String?
  caDepartment             String?
  caSubDepartment          String?
  caPlace                  String?
  permissionSentDate       DateTime?
  permissionReceivedFromCA DateTime?
  caSentToUnit             DateTime?
  permissionStatus         String?
  petitionId               String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  petition                 Petition  @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  @@index([petitionId])
  @@index([permissionStatus])
  @@index([department])
}

model PetitionHistory {
  id                  String   @id @default(uuid())
  petitionId          String
  fromStatus          String?
  toStatus            String
  action              String
  actionById          String?
  actionByDesignation String?
  remarks             String?
  createdAt           DateTime @default(now())

  petition Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  actionBy User?    @relation("HistoryActionBy", fields: [actionById], references: [id], onDelete: SetNull)

  @@index([petitionId])
  @@index([actionById])
}

// High Court stay / quash matters arising out of Lokayukta crime cases.
model CourtCase {
  id              String    @id @default(uuid())
  districtId      String
  crimeNo         String // Full KLA Crime No: KLA/[DIST]/[NUM]/[YEAR]
  complainantName String?
  firRegDate      DateTime?
  act             String? // Master (e.g. PC Act 1988)
  section         String? // Master dependent on Act
  caseType        String? // Trap, DA, Criminal Misconduct
  courtName       String? // Master
  sppName         String? // Master
  caseStage       String? // Under investigation, FR Submitted, Final Report Submitted, Chargesheeted, Stay, PT
  ccNo            String? // 6 digits
  ioName          String? // IO / Holding IO

  // Hon'ble High Court — Stay Details
  hcBench               String? // Bengaluru, Dharwad, Kalaburagi
  hcCourtHall           String? // 6 digits
  hcPetitionType        String? // WP, Crl.Pet, Appeal, Others
  hcPetitionNo          String? // 6 digits
  hcPetitionDate        DateTime?
  hcStayDate            DateTime?
  hcStayType            String? // Master
  hcCounselInformedDate DateTime? // Info Given to IO by Counsel
  hcPetitionerName      String?
  hcRespondents         String? // Lokayukta, ADGP, SP, DSP, PI
  hcParawiseRemarksDate DateTime? // Date of Parawise remarks by IO
  hcNextHearingDate     DateTime?
  hcCourtOrders         String? // Vacated, Quashed
  hcCounselName         String? // Name of the Counsel
  hcClcIntimationDate   DateTime? // Intimation to CLC by Counsel
  hcClcOpinion          String? // Fit, Not Fit
  hcClcOpinionDate      DateTime?

  // Hon'ble Supreme Court Details
  scPetitionType   String? // Slp No, Crl. Diary No
  scPetitionNo     String?
  scPetitionDate   DateTime?
  scPetitionerName String?
  scRespondents    String?
  scHearingDate    DateTime?
  scCourtOrders    String?
  scCounselName    String?

  // Backward compatibility aliases
  sectionOfLaw    String?
  wpCrlpNo        String?
  stayDate        DateTime?
  stayType        String?
  sppInformedDate DateTime?
  hcCaseStatus    String?
  slpNo           String?
  scCaseStatus    String?

  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  district    District              @relation(fields: [districtId], references: [id])
  createdBy   User?                 @relation("CourtCaseCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?                 @relation("CourtCaseUpdatedBy", fields: [updatedById], references: [id])
  agos        CourtCaseAgo[]
  actSections CourtCaseActSection[]

  @@index([districtId])
  @@index([hcBench])
  @@index([hcCourtOrders])
  @@index([sppName])
  @@index([hcStayDate])
  @@index([caseStage])
  @@index([isActive])
}

model CourtCaseAgo {
  id            String    @id @default(uuid())
  caseId        String
  name          String
  designation   String?
  department    String?
  subDepartment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  courtCase     CourtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CourtCaseActSection {
  id        String    @id @default(uuid())
  caseId    String
  act       String
  section   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  courtCase CourtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model EditRequest {
  id              String    @id @default(uuid())
  type            String
  recordId        String
  recordTitle     String?
  districtId      String?
  districtName    String?
  requestedById   String
  requestedByName String?
  reason          String
  status          String    @default("PENDING")
  expiresAt       DateTime?
  adminRemarks    String?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requestedBy User  @relation("EditRequest_requestedByIdToUser", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("EditRequest_reviewedByIdToUser", fields: [reviewedById], references: [id])

  @@index([districtName])
  @@index([requestedById])
  @@index([status])
  @@index([type, recordId])
}
